{
  "version": "v1.0",

  "listeners": [
    {
      "id": "$listener",
      "doc": "Consumes messages pulled from a subscribed Google Cloud Pub/Sub subscription and dispatches each to the attached service.",
      "type": { "name": "Listener" },
      "services": ["$service"],
      "multipleServicesAllowed": true
    }
  ],

  "serviceTypes": [
    {
      "id": "$service",
      "doc": "Consumes messages delivered from a subscribed Pub/Sub subscription.",
      "type": { "name": "Service" },
      "concrete": false,
      "multipleListenersAllowed": false,
      "annotations": ["$serviceConfig"],
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$service.onMessage",
            "name": "onMessage",
            "kind": "remote",
            "doc": "Invoked once per message pulled from the subscribed subscription.",
            "presence": "required",
            "params": [
              {
                "id": "$service.onMessage.message",
                "name": "message",
                "doc": "The delivered Pub/Sub message.",
                "type": { "name": "Message" },
                "presence": "required"
              },
              {
                "id": "$service.onMessage.caller",
                "name": "caller",
                "doc": "Handle for acknowledging or rejecting the message.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": { "id": "$service.onMessage.returns", "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
          },
          {
            "id": "$service.onError",
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when a pulled message cannot be dispatched to onMessage.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onError.err",
                "name": "err",
                "doc": "The failure that prevented dispatch.",
                "type": { "name": "Error" },
                "presence": "required"
              }
            ],
            "returns": { "id": "$service.onError.returns", "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
          }
        ]
      }
    }
  ],

  "annotations": [
    { "id": "$serviceConfig", "type": { "name": "ServiceConfig" }, "attachPoint": "service", "presence": "required" }
  ]
}
